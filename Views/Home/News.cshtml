@model NewsViewModel

@*
/// <summary>
/// News view displays current and archived news items for the iSchool.
/// This view renders a list of news articles from the NewsViewModel.
/// </summary>
/// <remarks>
/// The NewsViewModel is expected to contain:
/// - A collection of current news items in the "Older" property
/// - Each news item contains Date, Title, and Description fields
/// - The view displays a message if no news data is available
/// </remarks>
*@

<div class="container mt-4">
    <h1 class="display-4 mb-4">School News</h1>

    <div class="row mb-4">
        <div class="col-md-12">
            <div class="news-filters mb-4">
                <div id="news-search" class="ui-widget mb-3">
                    <label for="news-search-input">Search News: </label>
                    <input id="news-search-input" class="form-control">
                </div>

                <div id="news-filter-tabs" class="mt-3">
                    <ul>
                        <li><a href="#all-news">All News</a></li>
                        <li><a href="#recent-news">Recent News</a></li>
                        <li><a href="#archived-news">Archived News</a></li>
                    </ul>

                    <div id="all-news">
                        <div class="news-list">
                            @if (Model.Older is not null && Model.Older.Length > 0)
                            {
                                foreach (var news in Model.Older)
                                {
                                    <div class="news-item" data-date="@news.Date">
                                        <div class="news-date">@news.Date</div>
                                        <h4 class="news-title">@news.Title</h4>
                                        <p class="news-description">@news.Description</p>
                                        <button class="btn btn-sm btn-outline-primary news-read-more">Read More</button>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    No news available at this time.
                                </div>
                            }
                        </div>
                    </div>

                    <div id="recent-news">
                        <div class="news-list recent">
                            @if (Model.Older is not null && Model.Older.Length > 0)
                            {
                                var recentNews = Model.Older.Take(3).ToList();

                                if (recentNews.Any())
                                {
                                    foreach (var news in recentNews)
                                    {
                                        <div class="news-item" data-date="@news.Date">
                                            <div class="news-date">@news.Date</div>
                                            <h4 class="news-title">@news.Title</h4>
                                            <p class="news-description">@news.Description</p>
                                            <button class="btn btn-sm btn-outline-primary news-read-more">Read More</button>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-info">
                                        No recent news available.
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    No news available at this time.
                                </div>
                            }
                        </div>
                    </div>

                    <div id="archived-news">
                        <div class="news-list archived">
                            @if (Model.Older is not null && Model.Older.Length > 3)
                            {
                                var archivedNews = Model.Older.Skip(3).ToList();

                                if (archivedNews.Any())
                                {
                                    foreach (var news in archivedNews)
                                    {
                                        <div class="news-item" data-date="@news.Date">
                                            <div class="news-date">@news.Date</div>
                                            <h4 class="news-title">@news.Title</h4>
                                            <p class="news-description">@news.Description</p>
                                            <button class="btn btn-sm btn-outline-primary news-read-more">Read More</button>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-info">
                                        No archived news available.
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    No archived news available.
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4>News Calendar</h4>
                </div>
                <div class="card-body">
                    <div id="news-calendar"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- News Detail Dialog (hidden by default) -->
<div id="news-detail-dialog" title="News Details" style="display:none;">
    <div class="news-dialog-content">
        <div class="news-dialog-date"></div>
        <h3 class="news-dialog-title"></h3>
        <div class="news-dialog-description"></div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // News data
            var newsData = @Html.Raw(Json.Serialize(Model.Older));

            // Initialize tabs
            $("#news-filter-tabs").tabs();

            // Initialize search autocomplete
            var newsItems = [];
            if (newsData) {
                newsData.forEach(function(news) {
                    if (news.Title) {
                        newsItems.push(news.Title);
                    }
                });
            }

            $("#news-search-input").autocomplete({
                source: newsItems,
                select: function(event, ui) {
                    searchNews(ui.item.value);
                }
            });

            // Search function
            $("#news-search-input").on("keyup", function() {
                var searchText = $(this).val().toLowerCase();
                searchNews(searchText);
            });

            function searchNews(searchText) {
                $(".news-item").each(function() {
                    var title = $(this).find(".news-title").text().toLowerCase();
                    var description = $(this).find(".news-description").text().toLowerCase();

                    if (title.includes(searchText) || description.includes(searchText)) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            }

            // Initialize calendar
            $("#news-calendar").datepicker({
                beforeShowDay: function(date) {
                    // Highlight dates with news
                    var hasNews = false;
                    var tooltip = "";

                    if (newsData) {
                        newsData.forEach(function(news) {
                            if (news.Date) {
                                var newsDate = new Date(news.Date);
                                if (newsDate.getDate() === date.getDate() &&
                                    newsDate.getMonth() === date.getMonth() &&
                                    newsDate.getFullYear() === date.getFullYear()) {
                                    hasNews = true;
                                    tooltip += news.Title + "\n";
                                }
                            }
                        });
                    }

                    return [true, hasNews ? "has-news" : "", tooltip];
                },
                onSelect: function(dateText, inst) {
                    // Filter news by selected date
                    var selectedDate = new Date(dateText);
                    var formattedDate = (selectedDate.getMonth() + 1) + "/" + selectedDate.getDate() + "/" + selectedDate.getFullYear();

                    $(".news-item").each(function() {
                        var newsDate = $(this).data("date");
                        if (newsDate && newsDate.includes(formattedDate)) {
                            $(this).show();
                        } else {
                            $(this).hide();
                        }
                    });

                    // Switch to all news tab to show filtered results
                    $("#news-filter-tabs").tabs("option", "active", 0);
                }
            });

            // Initialize news detail dialog
            $("#news-detail-dialog").dialog({
                autoOpen: false,
                modal: true,
                width: 600,
                buttons: {
                    Close: function() {
                        $(this).dialog("close");
                    }
                }
            });

            // Read more button click
            $(".news-read-more").on("click", function() {
                var newsItem = $(this).closest(".news-item");
                var date = newsItem.find(".news-date").text();
                var title = newsItem.find(".news-title").text();
                var description = newsItem.find(".news-description").text();

                $(".news-dialog-date").text(date);
                $(".news-dialog-title").text(title);
                $(".news-dialog-description").text(description);

                $("#news-detail-dialog").dialog("open");
            });
        });
    </script>

    <style>
        /* News calendar styles */
        .has-news {
            background-color: #d4edda !important;
            border-radius: 50%;
        }

        .news-item {
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 8px;
            background-color: #fff;
            box-shadow: 0 4px 8px rgba(0,0,0,0.05);
            transition: all 0.3s ease;
        }

            .news-item:hover {
                box-shadow: 0 8px 16px rgba(0,0,0,0.1);
                transform: translateY(-2px);
            }

        .news-date {
            color: #6c757d;
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .news-title {
            color: #2c3e50;
            margin-bottom: 10px;
        }

        .news-description {
            margin-bottom: 15px;
            color: #495057;
        }

        #news-calendar {
            width: 100%;
        }

        #news-search {
            max-width: 500px;
            margin: 0 auto 20px;
        }

        /* Dialog styling */
        .news-dialog-date {
            color: #6c757d;
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 15px;
        }

        .news-dialog-title {
            color: #2c3e50;
            margin-bottom: 20px;
            border-bottom: 1px solid #eaeaea;
            padding-bottom: 10px;
        }

        .news-dialog-description {
            line-height: 1.6;
        }
    </style>
}