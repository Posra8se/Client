@model AboutViewModel

@*
 * View: Index.cshtml (Home/About page)
 * 
 * Purpose: Serves as the main landing page for the iSchool website, displaying
 * information about the school along with key statistics, program highlights,
 * and latest news.
 * 
 * Features:
 * - Displays school title, description, and quote from the AboutViewModel
 * - Shows key statistics about the school
 * - Provides program overview cards with links to detailed pages
 * - Displays latest news items
 *@

<div class="container mt-5">
    @* Hero section with school information *@
    <div class="row mb-5">
        <div class="col-lg-8 offset-lg-2 text-center">
            <h1 class="display-4 fw-bold mb-4 text-primary">@Model.title</h1>
            <p class="lead fs-4">@Model.description</p>

            <div class="mt-5">
                <a href="/Home/Undergraduate" class="btn btn-primary btn-lg mx-2">Undergraduate Programs</a>
                <a href="/Home/Graduate" class="btn btn-outline-primary btn-lg mx-2">Graduate Programs</a>
            </div>
        </div>
    </div>

    @* Quote section *@
    <div class="row mb-5">
        <div class="col-lg-8 offset-lg-2">
            <div class="quote-card p-4 text-center bg-light rounded shadow-sm">
                <i class="bi bi-quote fs-1 text-primary mb-3"></i>
                <blockquote class="blockquote mb-3">
                    <p class="fs-4 fst-italic">@Model.quote</p>
                </blockquote>
                <footer class="blockquote-footer fs-5">
                    <cite title="Source">@Model.quoteAuthor</cite>
                </footer>
            </div>
        </div>
    </div>

    @* Programs section *@
    <div class="row mb-5">
        <div class="col-12 text-center mb-4">
            <h2 class="display-5 fw-bold">Our Programs</h2>
            <p class="lead">Discover pathways to your future career</p>
        </div>

        @* Undergraduate Program Card *@
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="icon-circle mb-3 mx-auto">
                        <i class="bi bi-laptop fs-1 text-primary"></i>
                    </div>
                    <h3>Undergraduate</h3>
                    <p>Build a strong foundation with our industry-focused undergraduate programs.</p>
                    <ul class="list-unstyled text-start mx-4">
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Web & Mobile Computing</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Human Centered Computing</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Computing & Information Technologies</li>
                    </ul>
                    <a href="/Home/Undergraduate" class="btn btn-outline-primary mt-3">Learn More</a>
                </div>
            </div>
        </div>

        @* Graduate Program Card *@
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="icon-circle mb-3 mx-auto">
                        <i class="bi bi-mortarboard fs-1 text-primary"></i>
                    </div>
                    <h3>Graduate</h3>
                    <p>Take your career to the next level with our specialized graduate programs.</p>
                    <ul class="list-unstyled text-start mx-4">
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Information Sciences & Technologies</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Human Computer Interaction</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Networking & Systems Administration</li>
                    </ul>
                    <a href="/Home/Graduate" class="btn btn-outline-primary mt-3">Learn More</a>
                </div>
            </div>
        </div>

        @* Career Outcomes Card *@
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="icon-circle mb-3 mx-auto">
                        <i class="bi bi-briefcase fs-1 text-primary"></i>
                    </div>
                    <h3>Career Outcomes</h3>
                    <p>Our graduates excel in their careers across a variety of industries.</p>
                    <ul class="list-unstyled text-start mx-4">
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Industry-Leading Co-op Program</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Professional Employment Success</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Strong Alumni Network</li>
                    </ul>
                    <div class="mt-3">
                        <a href="/Home/CoOpTable" class="btn btn-outline-primary me-2">Co-op Data</a>
                        <a href="/Home/EmploymentTable" class="btn btn-outline-primary">Employment Data</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Key Stats section *@
    <div class="row mb-5 py-4 bg-light rounded">
        <div class="col-12 text-center mb-4">
            <h2 class="display-5 fw-bold">Key Stats</h2>
            <p class="lead">Our commitment to excellence</p>
        </div>

        <div class="col-md-4 text-center mb-4">
            <div class="stat-circle mx-auto mb-3">
                <span class="stat-number">94%</span>
            </div>
            <h4>Job Placement</h4>
            <p>of our graduates find employment within 6 months</p>
        </div>

        <div class="col-md-4 text-center mb-4">
            <div class="stat-circle mx-auto mb-3">
                <span class="stat-number">12+</span>
            </div>
            <h4>Degree Programs</h4>
            <p>specialized programs to match your career goals</p>
        </div>

        <div class="col-md-4 text-center mb-4">
            <div class="stat-circle mx-auto mb-3">
                <span class="stat-number">$80K</span>
            </div>
            <h4>Average Starting Salary</h4>
            <p>for our graduating students</p>
        </div>
    </div>

    @* Latest News section *@
    <div class="row mb-5">
        <div class="col-12 text-center mb-4">
            <h2 class="display-5 fw-bold">Latest News</h2>
            <p class="lead">Stay updated with the latest from our school</p>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="news-date text-muted mb-2">April 25, 2023</div>
                    <h4>Student Team Wins Hackathon</h4>
                    <p>A team of students from our Web & Mobile Computing program won first place at the regional hackathon.</p>
                    <a href="/Home/News" class="btn btn-link px-0">Read More →</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="news-date text-muted mb-2">April 18, 2023</div>
                    <h4>New Research Partnership</h4>
                    <p>Our school has established a new research partnership with a leading technology company.</p>
                    <a href="/Home/News" class="btn btn-link px-0">Read More →</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="news-date text-muted mb-2">April 10, 2023</div>
                    <h4>Alumni Success Story</h4>
                    <p>Recent graduate launches successful startup focused on accessibility technology.</p>
                    <a href="/Home/News" class="btn btn-link px-0">Read More →</a>
                </div>
            </div>
        </div>

        <div class="col-12 text-center mt-3">
            <a href="/Home/News" class="btn btn-primary">View All News</a>
        </div>
    </div>
</div>

@* Custom styles for the Index page *@
<style>
    /* Circle icons for program cards */
    .icon-circle {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background-color: rgba(13, 110, 253, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Circle backgrounds for statistics */
    .stat-circle {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background-color: #007bff;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Styling for statistic numbers */
    .stat-number {
        font-size: 2rem;
        font-weight: 700;
    }

    /* Styling for news dates */
    .news-date {
        font-size: 0.9rem;
        font-weight: 600;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Add simple hover effect to cards
            $('.card').hover(
                function() {
                    $(this).addClass('shadow');
                },
                function() {
                    $(this).removeClass('shadow');
                }
            );
        });
    </script>
}